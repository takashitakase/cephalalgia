# このファイルを .env にコピーして値を入力してください
# cp .env.example .env

# Notion インテグレーショントークン（必須）
# https://www.notion.so/my-integrations で取得
NOTION_TOKEN=secret_xxxxxxxxxxxx

# NCBI E-utilities APIキー（任意。設定するとレートリミットが 3→10 req/s に緩和）
# https://www.ncbi.nlm.nih.gov/account/ で取得
NCBI_API_KEY=

# NCBI に通知するメールアドレス（任意。設定を推奨）
NCBI_EMAIL=your@email.com
